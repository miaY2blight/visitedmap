<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12(API 31)以上のバックアップと端末間の移行の対象から、アプリのデータをすべて外す。
     allowBackup="false" だけでは、端末間の移行(device-transfer)を止められないため。
     端末内の DB に、検索語・丸めた範囲・記録した場所が入る(NFR-2)。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
